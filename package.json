{
  "name": "manancial-mangueiras-e-conexões",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://manancialmangueirasgo.com.br/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "optimize-media": "node scripts/optimize-images.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "ffmpeg-static": "^5.3.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.30",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
